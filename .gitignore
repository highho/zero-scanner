# Rust / cargo build artifacts
/app/target/

# Local cargo config pins machine-specific toolchain paths (rustc/MSVC).
# It would break builds on other machines, so it is not committed.
/app/.cargo/

# Local build helper scripts referencing this machine's toolchain paths
/app/build.ps1
/app/probe*.ps1

# Build / verification logs
*.log

# Release binaries are published as GitHub Release assets, not in the repo
/dist/

